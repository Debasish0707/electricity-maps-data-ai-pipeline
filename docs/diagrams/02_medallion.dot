digraph G {
 graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.3, ranksep=0.55, fontname="Arial"];
 node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, margin="0.15,0.09"];
 edge [color="#5B6573", penwidth=1.2, arrowsize=0.7, fontname="Arial", fontsize=8];
 source [label="API\nHourly FR Flows + Mix", fillcolor="#FFF2CC", color="#BF9000"];
 b [label="BRONZE\nRaw response exactly preserved\n+ ingestion_ts + source_url\nNo schema enforcement\nPartition: year/month/day", fillcolor="#FCE4D6", color="#C65911"];
 s1 [label="Parse + Flatten\nNested JSON → rows", fillcolor="#EAF2F8", color="#2F5597"];
 s2 [label="Schema Contract\nStrong types + UTC timestamps", fillcolor="#EAF2F8", color="#2F5597"];
 s3 [label="DQ + Dedup\nBusiness keys + quarantine", fillcolor="#E2F0D9", color="#548235"];
 s [label="SILVER DELTA\nParquet physical files\nPartition: data timestamp", fillcolor="#DDEBF7", color="#2F75B5"];
 g1 [label="Daily Mix\n% contribution by source", fillcolor="#E4DFEC", color="#7030A0"];
 g2 [label="Net Imports\nSource zone → France", fillcolor="#E4DFEC", color="#7030A0"];
 g3 [label="Net Exports\nFrance → destination", fillcolor="#E4DFEC", color="#7030A0"];
 g [label="GOLD DELTA\nFlat analytics-ready products\nParquet + Delta", fillcolor="#E4DFEC", color="#7030A0"];
 source -> b -> s1 -> s2 -> s3 -> s -> g;
 s -> g1; s -> g2; s -> g3;
}
